@startuml
!include theme.puml

abstract class Vehicle <<abstract>>{
- size: VehicleSize
- license_number: str
+ get_license_number() -> str
+ get_size() -> VehicleSize
}

enum VehicleSize <<enum>>{
    SMALL
    MEDIUM
    LARGE
}

VehicleSize <-r- Vehicle
Vehicle <|-- Car
Vehicle <|-- Bike
Vehicle <|-- Truck

class ParkingSpot{
    - spot_id: str
    - spot_size: VehicleSize
    - is_occupied: bool
    - parked_vehicle: Vehicle
    + park_vehicle(vehicle: Vehicle)
    + unpark_vehicle()
    + is_available() -> bool
}

class ParkingFloor{
    - floor_number: int
    - parking_spots: Dict[str, ParkingSpot]
}

class ParkingTicket{
    - ticket_id: str
    - vehicle: Vehicle
    - parking_spot: ParkingSpot
    - entry_timestamp: datetime
    - exit_timestamp: datetime
}

ParkingSpot --> Vehicle
ParkingFloor "1" *-- "many" ParkingSpot
ParkingTicket --> Vehicle
ParkingTicket --> ParkingSpot

' Pricing 

interface PricingStrategy<<interface>>{
    + calculate_fees(parking_ticket: ParkingTicket) -> float
}

class HourlyRateStrategy{
    + calculate_fees(parking_ticket: ParkingTicket) -> float
}
class VehicleBasedFeeStrategy{
    + calculate_fees(parking_ticket: ParkingTicket) -> float
}

PricingStrategy <|.. HourlyRateStrategy
PricingStrategy <|.. VehicleBasedRateStrategy

@enduml