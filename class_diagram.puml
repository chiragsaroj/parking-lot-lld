@startuml
!include theme.puml

' Vehicle
abstract class Vehicle <<abstract>>{
- size: VehicleSize
- vehicle_number: str
}

enum VehicleSize <<enum>>{
    SMALL
    MEDIUM
    LARGE
}

VehicleSize <-l- Vehicle
Vehicle <|-- Car
Vehicle <|-- Bike
Vehicle <|-- Truck

' Parking
class ParkingSpot{
    - spot_id: str
    - spot_size: VehicleSize
    - vehicle: Optional[Vehicle]
    + is_spot_available() -> bool
    + park_vehicle(vehicle: Vehicle) -> bool
    + remove_vehicle()
}

class ParkingFloor{
    - floor_number: int
    - parking_spots: List[ParkingSpot]
}

class ParkingLot<<singleton>>{
    - active_tickets: Dict[str, Ticket]
    - floors: List[ParkingFloor]
    - pricing_strategy: PricingStrategy
    + get_instance() -> ParkingLot
    + add_floor(floor: ParkingFloor)
    + park_vehicle(vehicle: Vehicle) -> Ticket
    + unpark_vehicle(ticket: Ticket) -> float
}

class Ticket{
    - ticket_id: str
    - vehicle: Vehicle
    - parking_spot: ParkingSpot
    - entry_timestamp: datetime
    - exit_timestamp: datetime
    - charges: float
    + close_ticket(charges: float)
    + set_exit_timestamp(exit_time: datetime)
}


ParkingLot --> Ticket
ParkingLot --> PricingStrategy
ParkingLot --> ParkingFloor
ParkingSpot --> Vehicle
ParkingFloor "1" *-- "many" ParkingSpot
Ticket --> Vehicle
Ticket --> ParkingSpot

' Pricing 

interface PricingStrategy<<interface>>{
    + calculate_price(ticket: Ticket) -> float
}

class HourlyPricingStrategy{
    - RATE_PER_HOUR: float
}
class VehiclePricingStrategy{
    - RATES: Dict[VehicleSize, float]
}

PricingStrategy <|.. HourlyPricingStrategy
PricingStrategy <|.. VehiclePricingStrategy

@enduml