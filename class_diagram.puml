@startuml
!include theme.puml

abstract class Vehicle <<abstract>>{
- size: VehicleSize
- license_number: str
+ get_license_number() -> str
+ get_size() -> VehicleSize
}

enum VehicleSize <<enum>>{
    SMALL
    MEDIUM
    LARGE
}

VehicleSize <-r- Vehicle
Vehicle <|-- Car
Vehicle <|-- Bike
Vehicle <|-- Truck

class ParkingSpot{
    - spot_id: str
    - spot_size: VehicleSize
    - is_occupied: bool
    - parked_vehicle: Vehicle
    + park_vehicle(vehicle: Vehicle)
    + unpark_vehicle()
    + is_available() -> bool
}

class ParkingFloor{
    - floor_number: int
    - parking_spots: List[ParkingSpot]
}

ParkingSpot --> Vehicle
ParkingFloor "1" *-- "many" ParkingSpot

@enduml