@startuml
!include theme.puml

' Vehicle
abstract class Vehicle <<abstract>>{
- size: VehicleSize
- vehicle_number: str
}

enum VehicleSize <<enum>>{
    SMALL
    MEDIUM
    LARGE
}

VehicleSize <-l- Vehicle
Vehicle <|-- Car
Vehicle <|-- Bike
Vehicle <|-- Truck

' Parking
class ParkingSpot{
    - spot_id: str
    - spot_size: VehicleSize
    - vehicle: Optional[Vehicle]
    + is_spot_available() -> bool
    + park_vehicle(vehicle: Vehicle) -> bool
    + remove_vehicle()
}


class ParkingLot<<singleton>>{
    - active_tickets: Dict[str, ParkingTicket]
    - floors: List[ParkingFloor]
    - pricing_strategy: PricingStrategy
    + get_instance() -> ParkingLot
    + add_floor(floor: ParkingFloor)
    + park_vehicle(vehicle: Vehicle) -> ParkingTicket
    + unpark_vehicle(ticket: ParkingTicket) -> float
}

class ParkingFloor{
    - floor_number: int
    - parking_spots: Dict[str, ParkingSpot]
}

class ParkingTicket{
    - ticket_id: str
    - vehicle: Vehicle
    - parking_spot: ParkingSpot
    - entry_timestamp: datetime
    - exit_timestamp: datetime
    + close_ticket(charges: float)
}


ParkingLot --> ParkingTicket
ParkingLot --> PricingStrategy
ParkingLot --> ParkingFloor
ParkingSpot --> Vehicle
ParkingFloor "1" *-- "many" ParkingSpot
ParkingTicket --> Vehicle
ParkingTicket --> ParkingSpot

' Pricing 

interface PricingStrategy<<interface>>{
    + calculate_price(parking_ticket: ParkingTicket) -> float
}

class HourlyRateStrategy{
    - RATE_PER_HOUR: float
}
class VehicleRateStrategy{
    - RATES: Dict[VehicleSize, float]
}

PricingStrategy <|.. HourlyRateStrategy
PricingStrategy <|.. VehicleRateStrategy

@enduml